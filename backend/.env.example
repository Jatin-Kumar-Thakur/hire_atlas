# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/job-tracker?retryWrites=true&w=majority

# ─── Authentication ───────────────────────────────────────────────────────────
# JWT_SECRET must be at least 32 random characters — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_minimum_32_character_random_secret_string
JWT_EXPIRES_IN=7d

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# For Gmail: enable 2FA and create an App Password at myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your_16_character_app_password

# ─── Frontend ─────────────────────────────────────────────────────────────────
# No trailing slash
CLIENT_URL=http://localhost:5173
